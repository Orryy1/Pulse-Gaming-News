# ---- Required ----------------------------------------------------------
DATABASE_URL=                 # Railway: ${{Postgres.DATABASE_URL}}
APP_SECRET=                   # long random string; signs links and encrypts the YouTube token
ADMIN_TOKEN=                  # long random string; guards /oauth/start, /episodes and /tick
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # your cloned voice (recommended) or a library voice
GOOGLE_CLIENT_ID=             # OAuth "Web application" client
GOOGLE_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=          # approvals, alerts and published notices

# ---- Behaviour (defaults shown) ----------------------------------------
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_MODEL=eleven_multilingual_v2
# DAILY_TARGET=1               # Shorts per UTC day
# SELECT_FROM_HOUR_UTC=9       # don't pick a story before this hour
# MIN_GAP_HOURS=4              # spacing between Shorts on DAILY_TARGET>1
# APPROVAL_MODE=timeout        # manual | timeout | auto
# APPROVAL_TIMEOUT_MINUTES=60  # timeout mode: auto-publish if not rejected (never for rumours)
# INCLUDE_RUMOURS=false
# PUBLISH_WINDOW_START_UTC=7   # outside the window uploads are scheduled for the next opening
# PUBLISH_WINDOW_END_UTC=22
# YOUTUBE_PRIVACY=public       # use unlisted for the first test run
# YOUTUBE_VETO_MINUTES=0       # >0 uploads privately and goes live this many minutes later
# VISION_QA=true
# MUSIC_BED=true
# DRY_RUN=false                # true = run everything except the YouTube upload
# MAX_ATTEMPTS=3
# TICK_MINUTES=10
# REMOTION_CONCURRENCY=2
# HEALTHCHECK_PING_URL=        # e.g. healthchecks.io ping URL, hit after every tick
# DATA_DIR=/data               # mount a Railway volume here
