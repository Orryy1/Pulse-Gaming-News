# factory/.env - written for you by INSTALL.cmd. Shown here for reference.

ANTHROPIC_API_KEY=
DISCORD_WEBHOOK_URL=
APP_SECRET=                    # random; signs links, encrypts the YouTube token
ADMIN_TOKEN=                   # random; guards the dashboard

# YouTube: reuse the Codex login, or connect at /oauth/start
PULSE_TOKEN_DIR=               # e.g. C:\Users\MORR\gaming-studio\pulse-gaming\tokens
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / YOUTUBE_REFRESH_TOKEN=

# Voice
VOICE_PROVIDER=auto            # auto | local | elevenlabs
LOCAL_TTS_URL=http://127.0.0.1:8765
LOCAL_TTS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
LOCAL_TTS_START=               # path to the Codex tts_server\start.bat
LOCAL_TTS_SPEAKING_RATE=1.0
ELEVENLABS_API_KEY=            # optional fallback
ELEVENLABS_VOICE_ID=
SYNTHETIC_MEDIA_DISCLOSURE=true

# Behaviour (defaults shown)
# DATA_DIR=.\data              # embedded database, media, logs
# DATABASE_URL=                # set only to use an external Postgres instead
# PUBLIC_URL=http://localhost:8080
# PORT=8080
# CLAUDE_MODEL=claude-opus-5-5
# Codex (the owner's ChatGPT plan, through C:\Claude\orchestrator\codex_runner.py) answers the listed steps
# instead of Claude, with Claude as the fallback for any failure. Only steps that run well ahead of a slot:
# doc.topic doc.outline doc.chapter doc.check doc.shots doc.bookends doc.photos, longform.topic longform.plan
# longform.write longform.shots, evergreen.topic evergreen.write, recap.package recap.chapter recap.bookends,
# titles.long, factcheck.ranking, search.write search.check (the search lane, made well ahead of its slot), reply.write (the video reply to a viewer's question); a family name ("doc") lists all of its steps, "*" everything (never do that:
# the news Short writer sits on the slot path). CODEX_VISION also routes listed steps that carry frames.
# The clarity gate's cold-read judge and plain rewrite are the steps clarity.judge and clarity.rewrite
# ("clarity" routes both; they run after the fact check, so a Short waits one or two Codex answers longer).
# CODEX_LLM=false
# CODEX_CALLS=
# CODEX_VISION=false
# CODEX_TIMEOUT_MINUTES=20
# CODEX_PYTHON=python
# CODEX_RUNNER_DIR=C:\Claude\orchestrator
# While the PC vision relay (Ollama) is down, picture checks never go to the paid Claude API unless this is on:
# they go to Codex where CODEX_VISION allows, otherwise they are skipped (one alert when it goes down, one when back).
# VISION_PAID_FALLBACK=false
# DAILY_TARGET=1
# BIG_STORY_MODE=report        # the big-story desk (src/bigstories.ts): off, report (say what it would do) or make
# BIG_STORY_SIZE=70            # size at which a story is big: never held by the cap, breaking allowance or the day's count
# BIG_STORY_HUGE=90            # past this: no daily ceiling, no same-game wait, the editor cannot pass
# BIG_STORY_PER_DAY=3          # big-story Shorts a day below BIG_STORY_HUGE
# BIG_STORY_MAX_AGE_HOURS=36   # how long a big story can still be made, angled on what has happened since
# BIG_STORY_RETRY_HOURS=6      # after a dropped big story: wait this long, and one more go only with a new article
# BIG_STORY_BUMPS=deals,spare,evergreen,why  # filler that gives way, one lane for each big story made today
# Same-day angle for official drops (src/editorial/dropangle.ts): a trailer, screenshot or reveal drop keeps the usual
# news slot and is written as one reframing idea, never a detail list; the weekly explained video never takes a drop
# DROP_ANGLE=false
# DROP_ANGLE_HOURS=12          # an official drop still goes out by this many hours after it landed, slot or not
# LAUNCH_CALENDAR_FILE=launches.json  # reviews and launch days of known huge games get planned coverage; empty = none
# CHATTER_SOURCES=bluesky,trends,youtube  # free signals that push a story's size, hourly; empty = none
# DAILY_TARGET_SHORTS_ONLY=true  # SHORTS_PER_DAY counts Shorts only, not long videos
# CLAUDE_MONTHLY_CREDIT=100    # the Claude credit in dollars, for the run-out forecast (src/claudecredit.ts); 0 = off
# CLAUDE_CREDIT_RENEW_DAY=1    # day of the month it renews
# CLAUDE_CREDIT_WARN_DAYS=10   # first warning when it would run out in under this many days
# SHORTS_PER_DAY_MAX=0         # news-lane Shorts a day (slots, breaking and Why) before later slots are held back; 0 = no cap
# Story-first mix (src/storymix.ts): two Why Shorts a day, one breaking Short (a second only at BREAKING_BIG_SCORE)
# WHY_SLOTS=12:00,18:30        # the Why slots; an older WHY_SLOT alone still means one slot
# WHY_FRESH_DAYS=14            # no Why game, topic or hook opening again inside this many days
# BREAKING_PER_DAY=1
# BREAKING_BIG_SCORE=95        # one more breaking Short past BREAKING_PER_DAY at this score or above; 0 = never
# The Why as a numbered serial (src/editorial/why.ts, format redesign plan item 3): numbered, longer, home shelf
# WHY_SERIAL_ENABLED=false
# WHY_TARGET_SECONDS=45-60     # the serial Why's length (only with WHY_SERIAL_ENABLED)
# WHY_HOME_SHARE=0             # share of Why slots, 0-1, that pick only from the home shelf; 0 = off
# WHY_HOME_FRANCHISES=Grand Theft Auto|Resident Evil   # names from HOME_SHELF; the third is chosen on 12 Dec
# The GTA File (src/gtafile.ts, plan item 4): a numbered daily GTA VI serial from a planned run file, in a Why slot
# (no slot is added). It replaced the STRAND_* settings, which are no longer read.
# SERIES_GTA_FILE_ENABLED=false
# SERIES_GTA_FILE_SLOT=18:30   # one of WHY_SLOTS
# SERIES_GTA_FILE_RUN_FILE=    # e.g. gta_file_run.json ("file" entries, src/shortrun.ts)
# Shorts length lanes (src/shortlengths.ts): seconds per format, words follow at the narrator's pace; empty = 25-40 s
# SHORT_LENGTHS=               # e.g. news=22-35,why=22-35,gta_file=45-55 (the old strand=... reads as gta_file)
# INSTAGRAM_MAX_SECONDS=0      # Instagram skips a Short longer than this (no shorter cut exists); 0 = no limit
# The demand check before evergreen, ranking and Why picks (src/discovery/searchdemand.ts): YouTube's own search
# page, this week by views, no API quota; topics under the bar are skipped, results cached 24 h
# DEMAND_CHECK=true
# DEMAND_MIN_VIEWS=20000       # views on a topic's top five recent videos below which it has no demand
# DEMAND_LOOKUPS=12            # search pages a pick at most
# REPEAT_MAX=3                 # a title or hook phrase this many of the last 30 days' Shorts used is sent back once (src/authenticity.ts); 0 = off
# Short structures (src/editorial/skeletons.ts): news Shorts rotate opening, order, length and ending, and no two of
# the newest 30 Shorts share one; the weekly analytics counts how often each ran
# SHORT_SKELETONS=false
# Before release a Short needs a point not in the picture (a reason, a verdict or a comparison) and some of Pulse's
# own material (owner capture, graphic, chart, on-screen source), else it goes back to the writer once, then out with a note, never held (src/qa/argues.ts)
# SHORT_ARGUES_CHECK=false
# GROWTH_TESTS=true            # the weekly retention test on news Shorts (src/growth.ts); false pauses it
# WEEKLY_EXPLAINED_TEST=true   # the weekly long video takes turns: round-up, then one story explained (src/weeklytest.ts); false = round-up only
# WEEKLY_EXPLAINED_LEAD_MINUTES=480 # while that test runs, the weekly long video's production starts this long before its slot
# SHORT_MEDIA_RICH_TARGET=0.85 # a Short's narration under its own picture, clip or card; under it, a summary line
# SELECT_FROM_HOUR_UTC=9
# MIN_GAP_HOURS=4
# APPROVAL_MODE=timeout        # manual | timeout | auto
# APPROVAL_TIMEOUT_MINUTES=60
# INCLUDE_RUMOURS=false
# PUBLISH_WINDOW_START_UTC=7
# PUBLISH_WINDOW_END_UTC=22
# YOUTUBE_PRIVACY=public
# YOUTUBE_VETO_MINUTES=0
# VISION_QA=true
# Long videos' thumbnails: one hero from the right game, 2-4 big words, no frames or panels (the GTA grid excepted).
# THUMB_HERO_RULE=true
# The Shorts' word-moment suite: nineteen looks rotated with a memory (src/render/wordlook.ts); false draws every one as the rubber stamp
# SHORT_WORD_LOOKS=true
# The long videos' craft on the new-look Shorts (src/render/shortcraft.ts), each layer on its own: Pulse-universe
# cards in the card rotation, treatments for real photos, fillers for bare lines, light camera moves (3 per 40 s at most)
# Code scenes (src/render/codescene.ts): drawn calendars, rulers, score ladders, lag races and shares, from a line's
# sourced data, over a plate or a repeated still, never over footage. Shorts and long videos.
# CODE_SCENES=false
# SHORT_CRAFT_CARDS=true
# SHORT_CRAFT_PHOTOS=true
# SHORT_CRAFT_FILLERS=true
# SHORT_CRAFT_CAMERA=true
# The clean frame on every Short: full-bleed footage, one overlay at a time besides the caption, the small Pulse mark,
# the source line for the first 3 s only, on-screen credits only where a licence asks (src/render/cleanframe.ts);
# the "clean frame" retention test (src/growth.ts) decides it once it has run
# SHORTS_CLEAN=true
# Long videos: the graphics check runs on stills before the render (every graphic, up to the cap), mutes
# faulted ones and renders once; the check on the finished video may ask for at most this many re-renders.
# GRAPHICS_PREPASS=true
# Long-video graphics fit their text and read as complete thoughts (compare card layout, kinetic lines whole,
# a scale card's giant word finishing its line). Off keeps the old layouts.
# GRAPHICS_FIT=true
# Look again at a faulted graphic before muting it; mute only if faulted twice.
# GRAPHICS_SECOND_LOOK=false
# The graphics audit before every render (src/qa/gfxaudit.ts): reading time (0.3 s a word + 0.6 s, at least 1.2 s),
# clashes, clipped text, figures against the narration and sources, alignment with the spoken line, and whether a
# graphic adds anything. off | report (log only) | fix (hold, move, trim or drop; fail only on a wrong graphic).
# GRAPHICS_AUDIT=off
# After a Short renders, each card's settled frame goes to the picture checker for clipped or overlapping text.
# GRAPHICS_FRAME_CHECK=false
# GRAPHICS_PREPASS_MAX=200
# GRAPHICS_RERENDER_PASSES=1
# GRAPHICS_POSTCHECK_MAX=32
# Documentaries: every shot scored 0-3 against the words over it before it may publish on its own
# (held for the owner under the mean, or over the share of screen time at 0).
# RELEASE_GATE=true
# RELEASE_GATE_MIN_MEAN=2.0
# RELEASE_GATE_MAX_ZERO=0.03
# A code reload (write data/admin/reload-requested) never happens this close before a slot.
# RELOAD_MINUTES_BEFORE_SLOT=30
# Long videos: the media gather stops with what it has after this long; every yt-dlp and ffmpeg download child
# is killed after DOWNLOAD_TIMEOUT_SECONDS; a long-lane pass not finished for LONG_TICK_STALL_MINUTES with no
# render or upload running is reported and its turn released.
# GATHER_MAX_MINUTES=45
# DOWNLOAD_TIMEOUT_SECONDS=300
# LONG_TICK_STALL_MINUTES=150
# MUSIC_BED=true
# Long videos: a real-world photo shows only on the sentence it was picked for (never as filler), and at most
# STOCK_THEME_MAX stock clips of one theme ("office at night") per video.
# REAL_PHOTOS_PINNED_ONLY=true
# STOCK_THEME_MAX=2
# More picture libraries (src/assets/libraries.ts, press.ts, stock.ts), each screened by the picture editor, its
# licence recorded in the provenance and its credit on screen. All on by default:
#   LIBRARY_PRESS: publishers' press and newsroom sites (Xbox Wire, PlayStation Blog, Sony Interactive,
#     CD PROJEKT RED, the Steam Deck press kit), editorial use, credited "Image: <Publisher> press".
#   LIBRARY_OPENVERSE: Openverse photos (Flickr and other archives), CC0, CC BY and CC BY-SA only (never NC or ND).
#   LIBRARY_PIXABAY: Pixabay video and photos, a second stock library next to Pexels. Needs a free PIXABAY_API_KEY
#     (pixabay.com/api/docs); without one it is skipped.
#   LIBRARY_ARCHIVE: Internet Archive films whose licence is public domain, CC0 or CC BY (no magazines, no adverts).
# LIBRARY_PRESS=true
# LIBRARY_OPENVERSE=true
# LIBRARY_PIXABAY=true
# PIXABAY_API_KEY=
# LIBRARY_ARCHIVE=true
# Long videos, footage first (src/assets/footagefirst.ts): once per video, before the picture top-up, each
# released game's chapter gathers Creative Commons gameplay (credited on screen) until moving footage can fill
# FOOTAGE_SHARE_TARGET percent of its narration: up to FOOTAGE_SOURCES videos, FOOTAGE_PULL_SECONDS of each,
# FOOTAGE_VISION_MAX segment frames checked on this PC's GPU per chapter (mods, kids' videos, facecams, menus
# and text refused), the pass stopping after FOOTAGE_FIRST_MAX_MINUTES. The plan never repeats a moment
# within a chapter, and the footage share is logged and posted for every long video.
# FOOTAGE_FIRST=true
# FOOTAGE_SHARE_TARGET=60
# FOOTAGE_SOURCES=6
# FOOTAGE_PULL_SECONDS=240
# FOOTAGE_VISION_MAX=120
# FOOTAGE_FIRST_MAX_MINUTES=40
# DRY_RUN=false
# MAX_ATTEMPTS=3
# TICK_MINUTES=10
# REMOTION_CONCURRENCY=2
# HEALTHCHECK_PING_URL=

# Games not on Steam: the publisher's own YouTube trailer (needs yt-dlp)
OFFICIAL_TRAILERS=true

# Rockstar Newswire data endpoint hashes (only if Rockstar rotates them)
# ROCKSTAR_NEWSWIRE_LIST_HASH=
# ROCKSTAR_NEWSWIRE_POST_HASH=
YTDLP_PATH=yt-dlp

# AI motion for a few documentary sketches of lines with movement, on this PC's own video model
# (Wan 2.2 TI2V 5B through ComfyUI at ILLUSTRATE_URL; src/assets/localvideo.ts). Off by default.
# ILLUSTRATE_VIDEO_ENABLED=false
# ILLUSTRATE_VIDEO_MAX=6
# ILLUSTRATE_VIDEO_TIMEOUT_SECONDS=600
# ILLUSTRATE_VIDEO_STUB=false

# Filler visuals for documentary lines nothing filmed can show (src/assets/fillers.ts): kinetic type,
# explainer diagrams, archive documents, drawn period scenes, silhouettes and in-game reconstructions,
# one chosen per bare or stock-only sentence, once per documentary. On by default.
# FILLERS_ENABLED=true

# The Mac mini's jobs (src/macworker.ts): each off by default, each falling back to the PC with a notice.
# MAC_WORKER_HOST=pulse-mac
# MAC_MIN_FREE_GB=40
# MAC_WAIT_MINUTES=10
# MAC_RENDER_CONCURRENCY=6
# MAC_ASR=false
# MAC_RENDER_SHORTS=false
# MAC_FOOTAGE_GATHER=false
# MAC_STILLS=false
# MAC_GAMEPLAY=false  (disable the two PC gameplay tasks first)
# The Mac's address for the /routine pages over the LAN, on their own port; empty keeps them loopback only.
# ROUTINE_LAN_ALLOW=192.168.0.157
# ROUTINE_LAN_PORT=8081
# Where a LAN routine's pictures go: "mac" (ssh copy; the factory on the PC) or "pc" (the PC's puller,
# windows/pull-routine-files.mjs, fetches them; the factory on the Mac). Empty picks by this machine: "pc" on a Mac.
# ROUTINE_FILES_TO=
# ROUTINE_PC_DIR=C:\PulseFactory\routine-files

# The launch run (src/shortrun.ts): topics fixed by date and slot. Empty = none.
# SHORT_RUN_FILE=launch_run.json
# Launch prep (GTA VI, Nov 2026; src/launchprep.ts). A planned Why is made this many hours early and held (0 = only
# entries with their own make_at or make_hours_before); a held Short is uploaded this long before its slot.
# RUN_PREMAKE_HOURS=0
# RUN_PREMAKE_UPLOAD_HOURS=2
# Slots a ready spare from the run fills when they would go out empty (default WHY_SLOTS), and how close to the slot.
# RUN_SPARE_SLOTS=
# RUN_SPARE_MINUTES=45
# A failed upload (YouTube or a cross-post) is tried 3 times this far apart, then moves to the next free slot (UPLOAD_MOVES times).
# UPLOAD_RETRY_MINUTES=10
# UPLOAD_MOVES=1
# An overnight breaking Short at this score moves the morning's first planned Short to the next open slot (0 = off).
# BREAKING_BUMP_SCORE=95
# With the PC picture checker down, Shorts with unchecked third-party pictures wait for it.
# VISION_HOLD=true
# GTA VI descriptions name the Leonida Intel page for the day, tagged ?utm_source=pulse.
# LEONIDA_LINK=true
# A planned documentary should be up as private this many hours before its slot; the owner hears if not.
# RUN_DOC_PRIVATE_HOURS=2
# Gameplay lane: a bar for clips saved on Xbox on purpose, hours before an unanswered Short expires (max 70),
# hours before its one reminder (0 = none), and a date until which every clip is a rehearsal that cannot publish.
# GAMEPLAY_MIN_SCORE_OWN=6
# GAMEPLAY_APPROVAL_HOURS=48
# GAMEPLAY_REMIND_HOURS=12
# GAMEPLAY_DIRECT=true             # the rebuilt Short: full screen, starts on the action, voice, payoff, loop (one more vision call a kept clip)
# GAMEPLAY_ONE_TAP=true            # the card's Approve and Reject act on the tap, with no confirmation page
# GAMEPLAY_REHEARSAL_UNTIL=2026-11-17
# A run documentary may use approved gameplay tests as a source, under a stricter check (src/editorial/testevidence.ts).
# DOC_TEST_EVIDENCE=true

# The alert loop: every post to the alerts channel is kept (data/logs/alerts.jsonl) and read back each morning
# (data/logs/alert_digest.md, posted only when a kind of alert is new or rising).
# ALERT_LEDGER=true
# ALERT_DIGEST=true
# The Inspiration rules for long videos (reports/Inspiration playlist forensics.md; src/editorial/longrules.ts). All off.
# PRIMARY_SOURCES=true             # Wikipedia is the map, not the source: briefs keep each sentence's references, the most-cited
#                                  # originals are read and added, the fact check reads them and descriptions credit them (13 Nov 2026)
# PRIMARY_SOURCES_MAX=4            # at most this many originals read per brief
# ATTRIBUTION_GUARD=true           # "Wikipedia" said on air, or the same attribution frame within ~60 s or over 3 times in a video,
#                                  # goes back to the writer once; the friend pass then varies what is left
# DOC_META_GUARD=true              # a chapter talking about its brief instead of the story is sent back, then dropped
# LONG_YOU_PER_1000=25              # least "you" per 1,000 words, measured on the script
# GUIDE_YOU_PER_1000=35             # the same in a guide
# LONG_SENTENCE_GATE=14             # mean sentence under this on rankings and guides
# LONG_HOOK_YOU_MIN=6               # the least "you" words in the opening, which the whole-video floor cannot see
# DOC_PICK_SINGLE_SUBJECT=true      # the picker drops series surveys and weighs each story by its shape
# FILM_SLATE_FILE=film_slate.json   # the ranked films from reports/Film slate November 2026.md go ahead of the score
# LONG_HOOK_STACK=5                 # stakes, 3 to this many named surprises, a trust line, one saved promise
# LONG_OPEN_LOOPS_MAX=8             # most loops in a guide; rankings get up to 3
# LOOP_NAME_PAYOFF=true             # a payoff says out loud it is the promise kept
# LONG_VERDICT_STAMPS=true          # confirmed, reported, busted, spoken and stamped in a guide
# LONG_GUIDE_FORMAT=true            # a run entry with format "guide" follows the player's journey
# GUIDE_CHAPTER_ACTION=true         # each guide chapter ends in a job for day one
# LONG_SAME_PICTURE_MAX_SECONDS=12  # no one still longer than this in any minute
# LONG_CARD_SHARE=0.3               # share of sentences carrying a card
# The weekly guide and the Shorts-to-long funnel test (src/longguide.ts, src/funnel.ts; upgrade queue 9 and 18). All off.
# GUIDE_WEEKLY=true                 # one long guide a week from guides.json, in its fixed title frame (needs LONG_GUIDE_FORMAT)
# GUIDE_WEEKLY_FILE=                # the plan; empty: guides.json beside package.json
# GUIDE_OWN_FIRST=true              # a weekly guide asks the owner's recordings for every footage target (default on)
# Full game retrospectives (src/retrospective.ts, upgrade item 26): 40-90 minutes, a chapter every 3-4 minutes, in the order
# history, making of, innovations, the full story act by act (scenes and lines from the scene index), best moments,
# reception (quoted reviews with their outlets), legacy. Opens on a spoiler warning; the title says it spoils.
# RETRO_ENABLED=false               # the strand; each game in retros.json also has its own "on"
# RETRO_FILE=                       # the plan; empty: retros.json beside package.json
# RETRO_MIN_INDEXED=0.95            # share of the game's full-story movie indexed before it can run (GAME_FETCH files it)
# RETRO_MIN_HEARD=400               # fewest heard lines in that index
# RETRO_QUOTES_STORY=3              # character quotes per story or best-moments chapter
# RETRO_QUOTES_OTHER=1              # per other chapter
# RETRO_QUOTES_MAX=40               # in the whole video
# RETRO_FOOTAGE_SCALE=1             # a chapter's publisher footage: PUBLISHER_FOOTAGE_SECONDS (per one-minute Short) x chapter minutes x this
# RETRO_CHAPTER_FOOTAGE_MAX=150     # ... at most this many seconds a chapter
# RETRO_OWN_FIRST=true              # the owner's recordings are asked for every footage target first
# RETRO_SANDBOX_CHAPTERS=           # sandbox only: write just these chapters ("1,story:1")
# Its model calls are its own sites, so CODEX_CALLS=retro routes the whole strand: retro.outline, retro.chapter, retro.check,
# retro.shots, retro.bookends, retro.friend, retro.quote. Speaker naming for games that print no names (GTA): the scene
# index tool's "speakers" command, site sceneindex.speakers.
# Moving footage in long videos (owner, 12 Nov 2026: nearly all moving footage); each off until switched on
# LONG_INWORLD_TEXT=false           # the game's own footage keeps in-world text (signs, HUD, its subtitles); only text not from the game is refused
# LONG_WATERMARK_CROP=false         # a clip with a small fixed corner mark is cut again cropped away from it ...
# LONG_WATERMARK_CROP_KEEP=0.78     # ... when the crop keeps at least this share of the picture
# RETRO_REMASTER_FOOTAGE=false      # a retrospective's reception and legacy chapters may show remaster footage, credited as such
# LONG_MOVING_FIRST=false           # the long planner plays any unplayed clip of a chapter before a still ...
# LONG_ACCENT_STILL_SECONDS=2.5     # ... and a still with footage still to come stays up this long at most
# LONG_CHAPTER_FOOTAGE=false        # every long video's chapters get their own publisher footage allowance, as a retrospective's
#                                   # (RETRO_FOOTAGE_SCALE, RETRO_CHAPTER_FOOTAGE_MAX); off: one per-Short allowance for the whole video
# DESCRIBE_HOURS=                   # scene index shot describing only in these local hours ("01-07"); empty: any time
# FUNNEL_TEST=true                  # 2-3 Shorts cut from each weekly guide; only Shorts cut from a long video get the related link
# FUNNEL_SHARE=0.5                  # share of those cuts that say and show the link (the rest are the control)
# FUNNEL_SHORTS=3                   # cuts per guide, one a day in CUTDOWN_SLOT (at most 3)
# FUNNEL_DAYS=3                     # cuts only while the guide is under this many days old
# FUNNEL_CLEAR_DAYS=60              # the routine lists earlier related links on other Shorts this far back for removal
# Test dials only, never for a normal run: LONG_STILL_XFADE_FRAMES=9 (0 is hard cuts); LONG_MIN_WPM=0 (rankings only).

# Community (all off by default; see reports/Community audit November 2026.md).
# FIRST_COMMENT_CHECK=true
# FIRST_COMMENT_QUESTION=true
# REPLY_STYLE=true
# REPLY_FOLLOWUPS=true
# META_COMMENT_REPLIES=true
# Clarity gate (src/editorial/clarity.ts, owner 13 Nov 2026): a judge reads every Short and documentary chapter cold,
# states its point, flags each confusing line and scores clarity 1-10; flagged lines get a plain rewrite, and a score
# under CLARITY_MIN goes back to the writer once first. Every rewrite keeps the facts and passes the fact check again.
# CLARITY_GATE=shorts,documentary   # "off" for none
# CLARITY_MIN=8
# Community engine (upgrade queue item 19): one friend-voice reply to every real viewer comment, one per person
# per video, and hearts plus one viewer pin per video for the Studio routine at /routine/viewers. Replaces the older
# reply passes while on. Needs the factory's stored YouTube login (the .env token has no comment scope).
# COMMUNITY_ENGINE=true
# COMMUNITY_REPLIES_PER_DAY=20
# COMMUNITY_REPLIES_PER_PASS=4
# Video replies to comments (src/commentreply.ts, needs COMMUNITY_ENGINE's filed comments): one Short a day answering
# the best viewer question (substantive, answerable from the video's confirmed facts, not hostile, a public @handle),
# opening on the comment as a card with "You asked...", made by the news pipeline in COMMENT_REPLY_SLOT, then one reply
# under the original comment pointing to it once public. YouTube links a reply video to a comment only in its Android
# app, so the factory cannot; the handle and the original video go in the description. Writer step: reply.write.
# COMMENT_REPLY_SHORTS=false
# COMMENT_REPLY_SLOT=16:30
# SOCIAL_SCOREBOARD=true
# ENGAGE_RETRY=true
# REQUESTS_FROM_SHORTS=true
# LAUNCH_COMMUNITY_POSTS=true

# The weekly analytics loop (all off by default; spec in reports/Analytics loop spec.md, src/analyticsloop.ts).
# ANALYTICS_LOOP=true            # Mondays 09:00: data/reports/analytics/latest.md + latest.json, Buffer TikTok numbers, fit tags
# ANALYTICS_LOOP_LESSONS=true    # up to six advice lines from the report in the writers' lessons
# ANALYTICS_LOOP_POSTING=true    # TikTok fit boost (25% at most) and Instagram format holds (1 in 5 still posted)
# ANALYTICS_LOOP_SCORING=true    # story-pick multiplier 0.85-1.15 on the news slot (never breaking news)
# Retention curve learning (src/retentionlearn.ts): every Short and long video's YouTube retention curve read at 48 hours
# on the factory's stored login (checked daily for the yt-analytics scope; the .env token lacks it), each drop lined up
# with the words, part, picture, card, stamp, cut, sound, quote, game sound and opening style on screen, and the
# patterns (3+ Shorts a side) written as lessons into the weekly report (writers' lessons via ANALYTICS_LOOP_LESSONS,
# lessons.md via the PC's pull) and the Sunday growth report. By hand: node --import tsx src/tools/retention-study.ts <dir>
# RETENTION_LEARN=false

# Stream asks (src/streamasks, 12 Nov 2026): a living list of what people want the owner to test on stream, from the
# press feeds, Bluesky, YouTube comments under the biggest videos and Pulse's own viewers, refreshed four times a day.
# A private page at <SITE_URL>/asks/<key> (the key is made from APP_SECRET; the daily message carries the link) and
# one Discord message a day before streaming with the top five. Rumours are labelled; story questions are held while
# SPOILER_GUARD's window is open. The tidying call is the step "streamasks.extract" (low tier): CODEX_CALLS can route it.
# STREAM_ASKS=false
# STREAM_ASKS_GAMES=Grand Theft Auto VI   # always listed; games named by the last three days' VOD titles are added
# STREAM_ASKS_SOURCES=seed,press,bluesky,youtube,viewers   # "reddit" only by choice: its robots.txt disallows bots
# STREAM_ASKS_SEED_FILE=docs/streamasks-seed-gta6.md
# STREAM_ASKS_REFRESH_HOURS=6
# STREAM_ASKS_POST_AT=10:00      # owner's time zone
# STREAM_ASKS_TOP=5
# STREAM_ASKS_STALE_DAYS=10      # seeds from the previews last three times as long
# STREAM_ASKS_DRY_RUN=false      # true: the daily message goes to data/streamasks/discord-<day>.txt
# YOUTUBE_API_KEY=               # optional; without it (or when expired) the factory's own YouTube login reads comments
# Search demand (src/searchq, 12 Nov 2026): what people type into YouTube and Google about big games, harvested every
# few hours from the public autocomplete endpoints (YouTube, Google, and DuckDuckGo for question forms; read only, one
# request at a time per site), clustered, scored by demand, freshness and how answerable it is from the confirmed
# facts file or the owner's play notes, and written to data/search/queries.json and a private page at
# <SITE_URL>/search/<key> (the key is made from APP_SECRET). The search lane makes one Short per query at its own
# slots, titled in the searcher's words; it never takes a news slot and is not counted in the news cap or the daily
# target. Writer and fact check are the steps "search.write" and "search.check": CODEX_CALLS=search routes both.
# SEARCH_SHORTS=false
# SEARCH_GAMES=Grand Theft Auto VI@2026-11-18T11:00:00Z   # "Name@first unlock;Name"; no date: already out
# SEARCH_FACTS=Grand Theft Auto VI=guide_facts_gta6.md     # "Name=file;...": confirmed lines with links; "## Reported" = rumour
# SEARCH_HARVEST_HOURS=4
# SEARCH_RATE_MS=1200            # pause between two requests to one site
# SEARCH_MAX_REQUESTS=240        # per harvest, all games together, shared out evenly
# SEARCH_PAA=true                # DuckDuckGo question forms (Google's "people also ask" has no free endpoint)
# SEARCH_SLOTS=15:00,20:00       # apart from the news and Why slots
# SEARCH_PER_DAY=1
# SEARCH_PER_DAY_LAUNCH=2
# SEARCH_LAUNCH_FROM=2026-11-18
# SEARCH_LAUNCH_UNTIL=2026-11-25
# SEARCH_MIN_SCORE=45            # 0-100
# SEARCH_COVERED_DAYS=120        # a Pulse video this recent that answers a query covers it
# VOD moment miner: each new TinoTV recording is indexed (cuts, Whisper, on-screen text, free local vision on the PC)
# into data/vodindex/<vod-id>/index.json and searched for the open asks. Proved or disproved needs the local model's
# confidence and two kinds of evidence; anything else stays unclear and is never published. Confident, spoiler-free
# moments go to the gameplay lane's inbox (still one tap in Discord) and data/streamasks/tested.json (weekly list).
# VOD_MINER=false
# VOD_MINER_DIR=                # default: Videos/TinoTV VODs in the home folder
# VOD_MINER_DAYS=7
# VOD_MINER_OCR_FPS=0.5
# VOD_MINER_CHUNK_MINUTES=20
# VOD_MINER_DESCRIBE_BATCH=300
# VOD_MINER_MIN_CUE=0.45
# VOD_MINER_MIN_CONFIDENCE=0.75
# VOD_MINER_TO_LANE=true
# Near-live clips (src/liveclips): while twitch.tv/<channel> is live, the stream's last minutes are copied to disk, its
# sound and action, its chat (Twitch's free anonymous read) and viewers' clips (TWITCH_CLIENT_ID/SECRET) are watched,
# and a big moment is cut and put first in the gameplay lane's inbox within minutes. The lane does the rest as ever
# (review, spoiler guard, voice, graphics audit) and the owner's one-tap card is the only way it publishes. Cuts wait
# while Pulse renders, then run at background priority. Moments already cut are skipped by the nightly finder (live_taken.json).
# LIVE_CLIPS=false
# LIVE_CLIPS_CHANNEL=tinotv
# LIVE_CLIPS_PER_HOUR=2
# LIVE_CLIPS_PER_DAY=8
# LIVE_CLIPS_GAP_MINUTES=10
# LIVE_CLIPS_MIN_SCORE=1          # 1 = one clear signal on its own; signals within 45 s add up
# LIVE_CLIPS_WARMUP_MINUTES=8     # loudness alone waits this long into a stream for a baseline
# LIVE_CLIPS_CHAT=true
# LIVE_CLIPS_CHAT_LOG=true        # data/liveclips/chat/<day>_<stream>.jsonl, to replay a stream (src/tools/liveclips-sim.ts)
# LIVE_CLIPS_VIEWER_CLIPS=true
# LIVE_CLIPS_LOUDNESS=true
# LIVE_CLIPS_BUFFER_MINUTES=6     # about 60 MB a minute at 1080p60
# LIVE_CLIPS_MAX_HEIGHT=1080
# LIVE_CLIPS_WAIT_MINUTES=20      # a cut's wait behind Pulse's renders before it tries again
# LIVE_CLIPS_PUBLISH_NOW=true     # an approved live Short goes out at the next free gap, not the evening gameplay slot
# The series (format redesign plan, C:\Claude\reports\pulse-format-redesign-plan.md; src/series.ts). All off; switch-on Sun 22 Nov.
# Every Short's script carries a series tag (why, gta_file, verdict, news_control) and the weekly analytics report shows
# subscribers per 1,000 views by series, with no setting.
# RUMOUR_SHARE=0                 # share of the day's rumour allowance kept: 0 stops rumour Shorts (default 1)
# SHORT_MIN_SECONDS=30           # the news writer's Shorts reach this much narration or are dropped (default 0, off)
# NEWS_LATE_SLOT_ENABLED=false   # drops the late news slot (21:00 or later) from NEWS_SLOTS (default true)
# BREAKING_HOME_ONLY=true        # breaking news only on the home shelf, or when the story desk rates it major
# HOME_SHELF=GTA|Grand Theft Auto|Resident Evil
# NEWS_SEGMENT_SERIES=true       # the Pulse Check on every series Short as well as news (NEWS_SEGMENT stays news only)
# SERIES_NEXT_LINE=true          # from 29 Nov: "Part 8 tomorrow: the map." on alternate days, only when the next part is dated
# Game audio and character lines (upgrade item 25, owner 12 Nov 2026), each off until switched on:
# CHARACTER_QUOTES_SHORT=2       # a Short may take a second character quote when a line fits the story itself (default 1)
# GAME_AUDIO_BED=true            # the footage's own game sound under the narration (src/assets/gameaudio.ts)
# GAME_AUDIO_SHARE=0.5           # share of videos that get it, split by episode; the Sunday report compares the two sides
# GAME_AUDIO_UNDER_LUFS=-30      # the bed under the voice (narration is -16)
# GAME_AUDIO_GAP_LUFS=-24        # the bed in the gaps between sentences
# GAME_AUDIO_TRAILERS=false      # trailer clips' sound too, 8 dB lower (default off: trailer music)
# GAME_AUDIO_MUSIC_DIP=0.6       # the music bed's level where the game sound plays
# The curated game archive (src/sceneindex/archive.ts, 12 Nov 2026). YouTube is the store: every backlog game gets a
# LIGHT scene index (captions, chapters, storyboard frames, comments; no video downloaded, about 1 MB a game); the
# best-ranked ARCHIVE_FULL_TOP also get the full index. Clips are pulled live from full-quality sections. Needs SCENE_INDEX.
ARCHIVE_BACKLOG=false
ARCHIVE_FULL_TOP=15
ARCHIVE_HOURS=22-7
ARCHIVE_COMMENTS=300
# keep | delete: delete removes a full index's 480p proxy once every stretch is indexed (describing then uses sections).
ARCHIVE_PROXY=keep
# With no proxy here, picture prechecks and describing fetch short low-resolution sections from YouTube.
ARCHIVE_SECTIONS=false
