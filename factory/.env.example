# factory/.env - written for you by INSTALL.cmd. Shown here for reference.

ANTHROPIC_API_KEY=
DISCORD_WEBHOOK_URL=
APP_SECRET=                    # random; signs links, encrypts the YouTube token
ADMIN_TOKEN=                   # random; guards the dashboard

# YouTube: reuse the Codex login, or connect at /oauth/start
PULSE_TOKEN_DIR=               # e.g. C:\Users\MORR\gaming-studio\pulse-gaming\tokens
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / YOUTUBE_REFRESH_TOKEN=

# Voice
VOICE_PROVIDER=auto            # auto | local | elevenlabs
LOCAL_TTS_URL=http://127.0.0.1:8765
LOCAL_TTS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
LOCAL_TTS_START=               # path to the Codex tts_server\start.bat
LOCAL_TTS_SPEAKING_RATE=1.0
ELEVENLABS_API_KEY=            # optional fallback
ELEVENLABS_VOICE_ID=
SYNTHETIC_MEDIA_DISCLOSURE=true

# Behaviour (defaults shown)
# DATA_DIR=.\data              # embedded database, media, logs
# DATABASE_URL=                # set only to use an external Postgres instead
# PUBLIC_URL=http://localhost:8080
# PORT=8080
# CLAUDE_MODEL=claude-opus-5-5
# Codex (the owner's ChatGPT plan, through C:\Claude\orchestrator\codex_runner.py) answers the listed steps
# instead of Claude, with Claude as the fallback for any failure. Only steps that run well ahead of a slot:
# doc.topic doc.outline doc.chapter doc.check doc.shots doc.bookends doc.photos, longform.topic longform.plan
# longform.write longform.shots, evergreen.topic evergreen.write, recap.package recap.chapter recap.bookends,
# titles.long, factcheck.ranking; a family name ("doc") lists all of its steps, "*" everything (never do that:
# the news Short writer sits on the slot path). CODEX_VISION also routes listed steps that carry frames.
# CODEX_LLM=false
# CODEX_CALLS=
# CODEX_VISION=false
# CODEX_TIMEOUT_MINUTES=20
# CODEX_PYTHON=python
# CODEX_RUNNER_DIR=C:\Claude\orchestrator
# DAILY_TARGET=1
# SHORTS_PER_DAY_MAX=0         # news-lane Shorts a day (slots + breaking) before later slots are held back; 0 = no cap
# GROWTH_TESTS=true            # the weekly retention test on news Shorts (src/growth.ts); false pauses it
# SHORT_MEDIA_RICH_TARGET=0.85 # a Short's narration under its own picture, clip or card; under it, a summary line
# SELECT_FROM_HOUR_UTC=9
# MIN_GAP_HOURS=4
# APPROVAL_MODE=timeout        # manual | timeout | auto
# APPROVAL_TIMEOUT_MINUTES=60
# INCLUDE_RUMOURS=false
# PUBLISH_WINDOW_START_UTC=7
# PUBLISH_WINDOW_END_UTC=22
# YOUTUBE_PRIVACY=public
# YOUTUBE_VETO_MINUTES=0
# VISION_QA=true
# The Shorts' word-moment suite: nineteen looks rotated with a memory (src/render/wordlook.ts); false draws every one as the rubber stamp
# SHORT_WORD_LOOKS=true
# Long videos: the graphics check runs on stills before the render (every graphic, up to the cap), mutes
# faulted ones and renders once; the check on the finished video may ask for at most this many re-renders.
# GRAPHICS_PREPASS=true
# GRAPHICS_PREPASS_MAX=200
# GRAPHICS_RERENDER_PASSES=1
# GRAPHICS_POSTCHECK_MAX=32
# Documentaries: every shot scored 0-3 against the words over it before it may publish on its own
# (held for the owner under the mean, or over the share of screen time at 0).
# RELEASE_GATE=true
# RELEASE_GATE_MIN_MEAN=2.0
# RELEASE_GATE_MAX_ZERO=0.03
# A code reload (write data/admin/reload-requested) never happens this close before a slot.
# RELOAD_MINUTES_BEFORE_SLOT=30
# Long videos: the media gather stops with what it has after this long; every yt-dlp and ffmpeg download child
# is killed after DOWNLOAD_TIMEOUT_SECONDS; a long-lane pass not finished for LONG_TICK_STALL_MINUTES with no
# render or upload running is reported and its turn released.
# GATHER_MAX_MINUTES=45
# DOWNLOAD_TIMEOUT_SECONDS=300
# LONG_TICK_STALL_MINUTES=150
# MUSIC_BED=true
# Long videos: a real-world photo shows only on the sentence it was picked for (never as filler), and at most
# STOCK_THEME_MAX stock clips of one theme ("office at night") per video.
# REAL_PHOTOS_PINNED_ONLY=true
# STOCK_THEME_MAX=2
# DRY_RUN=false
# MAX_ATTEMPTS=3
# TICK_MINUTES=10
# REMOTION_CONCURRENCY=2
# HEALTHCHECK_PING_URL=

# Games not on Steam: the publisher's own YouTube trailer (needs yt-dlp)
OFFICIAL_TRAILERS=true

# Rockstar Newswire data endpoint hashes (only if Rockstar rotates them)
# ROCKSTAR_NEWSWIRE_LIST_HASH=
# ROCKSTAR_NEWSWIRE_POST_HASH=
YTDLP_PATH=yt-dlp

# AI motion for a few documentary sketches of lines with movement, on this PC's own video model
# (Wan 2.2 TI2V 5B through ComfyUI at ILLUSTRATE_URL; src/assets/localvideo.ts). Off by default.
# ILLUSTRATE_VIDEO_ENABLED=false
# ILLUSTRATE_VIDEO_MAX=6
# ILLUSTRATE_VIDEO_TIMEOUT_SECONDS=600
# ILLUSTRATE_VIDEO_STUB=false

# Filler visuals for documentary lines nothing filmed can show (src/assets/fillers.ts): kinetic type,
# explainer diagrams, archive documents, drawn period scenes, silhouettes and in-game reconstructions,
# one chosen per bare or stock-only sentence, once per documentary. On by default.
# FILLERS_ENABLED=true
