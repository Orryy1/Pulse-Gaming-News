    {
      "frame": 2,
      "source": "local_whisper_word_alignment",
      "backend": "faster-whisper",
      "model": "faster-whisper:base.en",
      "transcript": "A fixed display keeps ticking at one rate, even while game frames finish early, late or somewhere between. Queen 8",
      "reconciliation": "coverage_ok_without_retiming",
      "word_count": 18,
      "first_word_start": 0,
